{
  "name": "dsh-meme-brain",
  "version": "0.1.0",
  "type": "module",
  "description": "表情包管理系统：解析、去重、入库、七维评分、检索与管理",
  "icon": "icon.svg",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "src/",
    "scripts/",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "characters.seed.json",
    "locale/*.json",
    "integrations/",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "verify": "node scripts/verify.mjs",
    "scan": "node scripts/scan-library.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "sticker",
    "meme",
    "表情包",
    "sqlite",
    "sharp",
    "aurabot",
    "qqbot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zihua0821/dsh-meme-brain.git"
  },
  "homepage": "https://github.com/zihua0821/dsh-meme-brain#readme",
  "bugs": {
    "url": "https://github.com/zihua0821/dsh-meme-brain/issues"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  }
}
