{
  "name": "dsh-meme-brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "表情包管理系统：解析、去重、入库、七维评分、检索与管理",
  "icon": "icon.svg",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "src/",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "scan": "node scripts/scan-library.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT",
  "dependencies": {
    "sharp": "^0.35.5"
  }
}
